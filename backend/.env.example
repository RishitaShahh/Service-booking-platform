# Database Configuration
# Default to SQLite for easy local development & pytest. 
# For PostgreSQL use: postgresql+asyncpg://user:password@localhost:5432/service_booking_db
DATABASE_URL=sqlite+aiosqlite:///./service_booking.db

# JWT Security Configuration
SECRET_KEY=supersecretkey_change_in_production_environment_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
